<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Glowing Background Aura of the blood drop -->
    <path
        android:pathData="M 54 22 C 54 22 28 54 28 72 C 28 86.36 39.64 98 54 98 C 68.36 98 80 86.36 80 72 C 80 54 54 22 54 22 Z"
        android:fillColor="#15EF4444" />

    <!-- Red Blood Drop with linear gradient -->
    <path
        android:pathData="M 54 24 C 54 24 30 54 30 71 C 30 84.25 40.75 95 54 95 C 67.25 95 78 84.25 78 71 C 78 54 54 24 54 24 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="24"
                android:endX="54"
                android:endY="95"
                android:type="linear">
                <item android:offset="0.0" android:color="#EF4444" />
                <item android:offset="1.0" android:color="#991B1B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- ECG / Heartbeat line drawn clearly in the center -->
    <path
        android:pathData="M 38 71 L 45 71 L 49 57 L 53 85 L 57 65 L 61 71 L 70 71"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
